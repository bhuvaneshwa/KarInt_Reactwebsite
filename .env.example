# Gmail Configuration
# Your Gmail address (the one that will send the emails)
EMAIL_USER=karinternationalinfotech@gmail.com

# Gmail App Password (16 characters without spaces)
# Generate this from: https://myaccount.google.com/apppasswords
# Steps to generate App Password:
# 1. Go to your Google Account Settings
# 2. Click on "Security" in the left sidebar
# 3. Under "How you sign in to Google", enable 2-Step Verification (if not already enabled)
# 4. Once 2-Step is enabled, go back to Security
# 5. Under "How you sign in to Google", click on "App passwords"
# 6. Select "Mail" as the app and your device
# 7. Click "Generate"
# 8. Copy the 16-character password and paste it below (no spaces)
EMAIL_PASSWORD=your-app-password-here
